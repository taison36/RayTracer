@startuml 07_architecture
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam ArrowColor #555555
skinparam ClassBorderColor #444444
skinparam ClassBackgroundColor #FAFAFA
skinparam PackageBorderColor #888888

title GPU Ray Tracer — Architecture

' ── Application ─────────────────────────
package "Application" {
    class RayTracerApplication {
        - scene          : Scene
        - screenSettings : SceneSettings
        - buffer         : FrameBuffer
        - renderer       : Renderer
        --
        + run()
        + save_as_ppm()
    }
}

' ── Core ────────────────────────────────
package "Core" {
    class Scene {
        + vertices   : vector<Vertex>
        + triangles  : vector<Triangle>
        + materials  : vector<Material>
        + textures   : vector<Texture>
        + lights     : DirectionalLight / PointLight / SpotLight
        + camera     : Camera
    }

    class FrameBuffer {
        + pixels : vector<Color>
        --
        + operator[](row) : Color*
    }

    class SceneLoader <<utility>> {
        + {static} loadScene(path) : Scene
    }
}

' ── Rendering ───────────────────────────
package "Rendering" {
    class RendererContext {
        + scene          : const Scene*
        + screenSettings : const SceneSettings*
    }

    class Renderer {
        - vkCore      : VkCore
        - accelStruct : AccelerationStruct
        --
        + run(ctx, fb)
    }

    class VkCore {
        + device, queue, commandPool
        --
        + createBuffer()
        + beginSingleTimeCommands()
        + transitionImageLayout()
    }
}

' ── Acceleration Structures ─────────────
package "Acceleration Structures" {
    abstract class AccelerationStruct {
        + {abstract} build(vkCore, ctx, outputImage)
        + {abstract} record(cmdBuf, tile, sample)
    }

    class BruteForce
    class BVH
    class SAHBVH
    class KDTree {
        - builder : IKDTreeBuilder
    }

    interface IKDTreeBuilder {
        + {abstract} build(triangles, vertices, outNodes, outIndices)
    }

    class BinnedSAHBuilder
    class ExactSAHBuilder
}

' ── Relationships ───────────────────────
RayTracerApplication *-- Scene
RayTracerApplication *-- FrameBuffer
RayTracerApplication *-- Renderer
RayTracerApplication ..> RendererContext : constructs

SceneLoader ..> Scene : produces

RendererContext --> Scene

Renderer *-- VkCore
Renderer o-- AccelerationStruct
Renderer ..> RendererContext : uses
Renderer ..> FrameBuffer    : writes

AccelerationStruct <|-- BruteForce
AccelerationStruct <|-- BVH
AccelerationStruct <|-- SAHBVH
AccelerationStruct <|-- KDTree

KDTree o-- IKDTreeBuilder
IKDTreeBuilder <|.. BinnedSAHBuilder
IKDTreeBuilder <|.. ExactSAHBuilder

@enduml
