@startuml 05_bvh
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam ArrowColor #555555
skinparam ClassBorderColor #444444
skinparam ClassBackgroundColor #FAFAFA
skinparam PackageBorderColor #888888
skinparam NoteBackgroundColor #FFFDE7

title BVH Acceleration Structure

abstract class AccelerationStruct <<see 04_acceleration_structures>> {
    + {abstract} build(...)
    + {abstract} record(...)
}

' ── BVH ─────────────────────────────────
class BVH {
    ' Vulkan resources
    - descriptorPool   : vk::DescriptorPool
    - descriptorLayout : vk::DescriptorSetLayout
    - pipeline         : vk::Pipeline
    - pipelineLayout   : vk::PipelineLayout
    ' Scene buffers
    - vertexBuf        : Buffer
    - triangleBuf      : Buffer
    - materialBuf      : Buffer
    - settingsBuf      : Buffer
    - accumBuf         : Buffer
    - lightBufs        : Buffer[3]
    - textures         : TextureImage[]
    ' BVH-specific
    - bvhNodeBuf       : Buffer
    - bvhTriIdxBuf     : Buffer
    - builder          : unique_ptr<IBVHBuilder>
    --
    + build(vkCore, ctx, outImg)
    + record(cmdBuf, tileW, tileH, sample, offX, offY)
    + getTypeName() : builder->getName()
}

' ── Builder interface ────────────────────
interface IBVHBuilder {
    + {abstract} build(tris     : vector<Triangle>,\n               verts    : vector<Vertex>,\n               outNodes : vector<BVHNode>&,\n               outIdx   : vector<uint32_t>&)
    + {abstract} getName() : string
}

' ── Concrete builders ────────────────────
class MiddlePointBuilder {
    --
    + build(...)
    + getName() : "BVH-Midpoint"
    --
    Splits at centroid midpoint
    of the longest AABB axis.
    O(n log n) — fast build.
}

class SAHBuilder {
    - NUM_BINS : int = 8
    - C_TRAV   : float = 1.2
    --
    + build(...)
    + getName() : "BVH-SAH"
    --
    Minimises SAH cost:
    C_trav + (A_L/A_P)*N_L
           + (A_R/A_P)*N_R
    8-bin sweep per axis.
}

' ── GPU node format ─────────────────────
package "GPU Node Format" {
    class BVHNode <<GPU struct, 32 bytes>> {
        aabbMinLeft  : vec4
        ' xyz = AABB min
        ' w   = left child idx (interior) / first tri idx (leaf)
        aabbMaxCount : vec4
        ' xyz = AABB max
        ' w   = 0 (interior) / tri count (leaf)
    }
}

' ── CPU build helpers ───────────────────
package "CPU Build Helpers" {
    class AABB {
        + min, max : vec3
        --
        + expand(p : vec3)
        + surfaceArea() : float
        + centroid()    : vec3
    }
}

' ── Relationships ───────────────────────
AccelerationStruct <|-- BVH

BVH o-- IBVHBuilder : «strategy»
IBVHBuilder <|.. MiddlePointBuilder
IBVHBuilder <|.. SAHBuilder

IBVHBuilder ..> BVHNode : produces

MiddlePointBuilder ..> AABB : uses
SAHBuilder         ..> AABB : uses

@enduml
